generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model persona {
  id_persona Int           @id @default(autoincrement())
  ci         String        @unique @db.VarChar(100)
  nombres    String        @db.VarChar(100)
  apellidos  String        @db.VarChar(100)
  correo     String        @unique @db.VarChar(100)
  telefono   String?       @db.VarChar(100)
  password   String        @db.VarChar(100)
  roles      rol_usuario[]
}

model rol_usuario {
  id_rol     Int                 @id @default(autoincrement())
  id_persona Int
  privilegio privilegio_usuario?
  persona    persona             @relation(fields: [id_persona], references: [id_persona])

  @@map("rol_usuario")
}

model privilegio_usuario {
  id_rol            Int         @id
  nombre_privilegio String      @db.VarChar(100)
  rol               rol_usuario @relation(fields: [id_rol], references: [id_rol])

  @@map("privilegio_usuario")
}
