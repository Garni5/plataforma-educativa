// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ USUARIOS Y ROLES ============

model persona {
  id_persona Int      @id @default(autoincrement())
  nombres    String   @db.VarChar(100)
  apellidos  String   @db.VarChar(100)
  correo     String   @db.VarChar(100) @unique
  password   String   @db.VarChar(100)

  // Relaciones
  roles      rol_usuario[]
  cursos     curso_profesor[]  // Cursos asignados al profesor
}

model rol_usuario {
  id_rol     Int      @id @default(autoincrement())
  id_persona Int
  persona    persona  @relation(fields: [id_persona], references: [id_persona], onDelete: Cascade)

  // Relación con privilegio_usuario
  privilegio privilegio_usuario?

  @@map("rol_usuario")
}

model privilegio_usuario {
  id_rol           Int      @id
  nombre_privilegio String  @db.VarChar(100)

  // Relación inversa
  rol              rol_usuario @relation(fields: [id_rol], references: [id_rol], onDelete: Cascade)

  @@map("privilegio_usuario")
}

// ============ CURSOS Y CONTENIDO ============

model curso {
  id          Int      @id @default(autoincrement())
  titulo      String   @db.VarChar(255)
  descripcion String?  @db.Text
  
  // Relaciones
  profesores  curso_profesor[]
  topicos     topico[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Tabla intermedia: Profesor - Curso
model curso_profesor {
  id         Int      @id @default(autoincrement())
  
  // Profesor
  id_persona Int
  persona    persona  @relation(fields: [id_persona], references: [id_persona], onDelete: Cascade)
  
  // Curso
  id_curso   Int
  curso      curso    @relation(fields: [id_curso], references: [id], onDelete: Cascade)
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@unique([id_persona, id_curso])
  @@index([id_persona])
  @@index([id_curso])
}

model topico {
  id          Int      @id @default(autoincrement())
  titulo      String   @db.VarChar(255)
  descripcion String?  @db.Text
  
  // Relación con Curso
  id_curso    Int
  curso       curso    @relation(fields: [id_curso], references: [id], onDelete: Cascade)
  
  // Relación con Recursos
  recursos    recurso[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([id_curso])
}

model recurso {
  id               Int      @id @default(autoincrement())
  titulo           String   @db.VarChar(255)
  tipo             String   @db.VarChar(50)  // 'video', 'document', 'slides', 'audio'
  descripcion      String?  @db.Text
  url_archivo      String?  @db.VarChar(500)
  nombre_archivo   String?  @db.VarChar(255)
  tamano_archivo   Int?     // Tamaño en bytes
  tipo_mime        String?  @db.VarChar(100)
  tiene_transcripcion Boolean? // Solo para videos
  
  // Relación con Tópico
  id_topico        Int
  topico           topico   @relation(fields: [id_topico], references: [id], onDelete: Cascade)
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  @@index([id_topico])
}