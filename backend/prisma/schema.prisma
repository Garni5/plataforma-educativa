generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model persona {
  id_persona Int                 @id @default(autoincrement())
  nombres    String              @db.VarChar(100)
  apellidos  String              @db.VarChar(100)
  correo     String              @unique @db.VarChar(100)
  telefono   String?             @db.VarChar(100)
  password   String?             @db.VarChar(100)
  roles      privilegio_usuario[] @relation("PersonaRoles")
}

model privilegio_usuario {
  id_rol            Int       @id @default(autoincrement())
  nombre_privilegio String    @db.VarChar(100)
  personas          persona[] @relation("PersonaRoles")
}
